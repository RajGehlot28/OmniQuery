OPENAI_API_KEY=your_openai_api_key_here
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_URL=your_qdrant_cluster_url_here

# Database Configuration (options: postgresql, mysql, mongodb)
DB_TYPE=postgresql
DATABASE_URL=postgresql+psycopg2://postgres:password123@localhost:5432/company_db

# Dummy URLs for switching:
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:password123@localhost:5432/company_db
# MySQL:
# DATABASE_URL=mysql+pymysql://root:password123@localhost:3306/company_db
# MongoDB:
# DATABASE_URL=mongodb+srv://admin:password123@cluster0.abcde.mongodb.net/company_db
